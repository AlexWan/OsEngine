<Window x:Class="OsEngine.Market.ServerEncryption.ServerEncryptionUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Encryption" Height="330" Width="560" Topmost="True" Style="{StaticResource WindowStyleNoResize}" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="/Images/OsLogo.ico">
    <Grid>
        <TabControl Name="TabControlEncryption" Margin="0,0,0,40">

            <TabItem Name="TabItemSetup" Header=" Setup ">
                <Grid>
                    <Label Name="LabelNewPasswordSetup" Content="New password" Margin="10,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxNewPasswordSetup" Margin="10,37,10,0" VerticalAlignment="Top" Height="23"/>
                    <Label Name="LabelRepeatPasswordSetup" Content="Repeat password" Margin="10,70,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxRepeatPasswordSetup" Margin="10,92,10,0" VerticalAlignment="Top" Height="23"/>
                    <Label Name="LabelErrorSetup" Content="" Margin="10,120,10,0" VerticalAlignment="Top" Foreground="#FFFF5050"/>
                    <Label Name="LabelForgotNoteSetup" Content="Forgotten password cannot be recovered" Margin="10,150,10,0" VerticalAlignment="Top"/>
                    <Button Name="ButtonAboutSetup" Content="?" HorizontalAlignment="Left" Margin="10,0,0,10" VerticalAlignment="Bottom" Width="30" Height="25" Click="ButtonAboutSetup_Click"/>
                    <Button Name="ButtonSetup" Content="Enable" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="170" Height="25" Click="ButtonSetup_Click"/>
                </Grid>
            </TabItem>

            <TabItem Name="TabItemUnlock" Header=" Unlock ">
                <Grid>
                    <Label Name="LabelCaptionUnlock" Content="Passwords are encrypted. Enter the master password to unlock" Margin="10,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Label Name="LabelCurrentPasswordUnlock" Content="Current password" Margin="10,45,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxCurrentPasswordUnlock" Margin="10,67,10,0" VerticalAlignment="Top" Height="23"/>
                    <Label Name="LabelErrorUnlock" Content="" Margin="10,95,10,0" VerticalAlignment="Top" Foreground="#FFFF5050"/>
                    <Label Name="LabelForgotNoteUnlock" Content="Forgotten password cannot be recovered" Margin="10,125,10,0" VerticalAlignment="Top"/>
                    <Button Name="ButtonAboutUnlock" Content="?" HorizontalAlignment="Left" Margin="10,0,0,10" VerticalAlignment="Bottom" Width="30" Height="25" Click="ButtonAboutUnlock_Click"/>
                    <Button Name="ButtonUnlock" Content="Unlock" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="170" Height="25" Click="ButtonUnlock_Click"/>
                </Grid>
            </TabItem>

            <TabItem Name="TabItemChange" Header=" Change ">
                <Grid>
                    <Label Name="LabelCurrentPasswordChange" Content="Current password" Margin="10,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxCurrentPasswordChange" Margin="10,37,10,0" VerticalAlignment="Top" Height="23"/>
                    <Label Name="LabelNewPasswordChange" Content="New password" Margin="10,70,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxNewPasswordChange" Margin="10,92,10,0" VerticalAlignment="Top" Height="23"/>
                    <Label Name="LabelRepeatPasswordChange" Content="Repeat password" Margin="10,125,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxRepeatPasswordChange" Margin="10,147,10,0" VerticalAlignment="Top" Height="23"/>
                    <Label Name="LabelErrorChange" Content="" Margin="10,175,10,0" VerticalAlignment="Top" Foreground="#FFFF5050"/>
                    <Button Name="ButtonAboutChange" Content="?" HorizontalAlignment="Left" Margin="10,0,0,10" VerticalAlignment="Bottom" Width="30" Height="25" Click="ButtonAboutChange_Click"/>
                    <Button Name="ButtonChange" Content="Change password" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="170" Height="25" Click="ButtonChange_Click"/>
                </Grid>
            </TabItem>

            <TabItem Name="TabItemDisable" Header=" Disable ">
                <Grid>
                    <Label Name="LabelWarningDisable" Content="Encryption will be disabled. All keys will be decrypted to plain text" Margin="10,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Label Name="LabelCurrentPasswordDisable" Content="Current password" Margin="10,45,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxCurrentPasswordDisable" Margin="10,67,10,0" VerticalAlignment="Top" Height="23"/>
                    <Label Name="LabelErrorDisable" Content="" Margin="10,95,10,0" VerticalAlignment="Top" Foreground="#FFFF5050"/>
                    <Button Name="ButtonAboutDisable" Content="?" HorizontalAlignment="Left" Margin="10,0,0,10" VerticalAlignment="Bottom" Width="30" Height="25" Click="ButtonAboutDisable_Click"/>
                    <Button Name="ButtonDisable" Content="Disable" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="170" Height="25" Click="ButtonDisable_Click"/>
                </Grid>
            </TabItem>

        </TabControl>

        <Button Name="ButtonClose" Content="Close" HorizontalAlignment="Right" Margin="0,0,10,8" VerticalAlignment="Bottom" Width="120" Height="25" Click="ButtonClose_Click"/>
    </Grid>
</Window>
