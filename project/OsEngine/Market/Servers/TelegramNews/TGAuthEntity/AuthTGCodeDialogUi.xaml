<Window x:Class="OsEngine.Market.Servers.TelegramNews.TGAuthEntity.AuthTGCodeDialogUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TelegramNews" Height="165" Width="310" ResizeMode="NoResize" Style="{StaticResource WindowStyleCanResize}" WindowStartupLocation="CenterScreen" Icon="/Images/OsLogo.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Name="LabelCode" Content="Authorization code" Grid.Row="0" HorizontalAlignment="Center"/>
        <TextBox Name="TextBoxCode" Grid.Row="1" Width="150" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="ButtonSend" Content="Send" Width="120" IsDefault="True" Margin="0,0,10,0"/>
            <Button Name="ButtonCancel" Content="Cancel" Width="120" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
