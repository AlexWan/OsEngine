<Window x:Class="OsEngine.OsCapitalAllocation.CapitalAllocationJournalUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cluster journal" Height="640" Width="1000"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyleCanResize}"
        MinWidth="700" MinHeight="480"
        Icon="/Images/OsLogo.ico">
    <Grid>
        <TabControl Name="TabControlPrime" BorderThickness="0" Background="{DynamicResource StandardBackgroundBrush}">
            <TabItem Header="Equity">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Name="ButtonHelpEquity" Content="?" Grid.Row="0" HorizontalAlignment="Right" Width="28" Height="28" Margin="0,0,10,0"/>
                    <WindowsFormsHost Name="HostEquity" Grid.Row="1"/>
                </Grid>
            </TabItem>
            <TabItem Header="Statistics">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Name="ButtonHelpStatistics" Content="?" Grid.Row="0" HorizontalAlignment="Right" Width="28" Height="28" Margin="0,0,10,0"/>
                    <WindowsFormsHost Name="HostStatistics" Grid.Row="1"/>
                </Grid>
            </TabItem>
            <TabItem Header="Closed positions">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Name="ButtonHelpClosedPositions" Content="?" Grid.Row="0" HorizontalAlignment="Right" Width="28" Height="28" Margin="0,0,10,0"/>
                    <WindowsFormsHost Name="HostPositions" Grid.Row="1"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
