<Project Sdk="Microsoft.NET.Sdk">
  <!-- BUG-0651 (bug-0655) юниты S1-S3 маппинга галки «Hedge Mode» (см. Program.cs). Не входит в OsEngine.sln: собирается отдельно.
       EngineBin — каталог bin движка; ПЕРЕСОБЕРИТЕ OsEngine перед прогоном (в git bin\Debug отстаёт от исходников). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>OsEngine.Woo.HedgeModeUnits</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EngineBin>$(MSBuildThisFileDirectory)..\..\OsEngine\bin\Debug</EngineBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="OsEngine"><HintPath>$(EngineBin)\OsEngine.dll</HintPath></Reference>
  </ItemGroup>
</Project>
