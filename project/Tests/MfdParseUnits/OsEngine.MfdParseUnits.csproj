<Project Sdk="Microsoft.NET.Sdk">
  <!-- bug-0633 (публ. bug-0640) gap C: G1-G4 durable юниты парсера MFD (см. Program.cs).
       Не входит в OsEngine.sln: собирается отдельно (прецедент a42d76802).
       EngineBin — каталог bin движка; ПЕРЕСОБЕРИТЕ OsEngine перед прогоном (в git bin\Debug отстаёт от исходников). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>OsEngine.MfdParseUnits</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EngineBin>$(MSBuildThisFileDirectory)..\..\OsEngine\bin\Debug</EngineBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="OsEngine"><HintPath>$(EngineBin)\OsEngine.dll</HintPath></Reference>
  </ItemGroup>
</Project>
